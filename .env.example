# Copy to .env and fill in. Never commit .env.

# --- Database (Supabase: Project Settings > Database > Connection string, "Session pooler" URI) ---
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Sign-in (Supabase: Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Optional. If your project still uses the legacy JWT secret, set it here; otherwise leave blank
# and the server verifies tokens with the project's public signing keys.
SUPABASE_JWT_SECRET=

# --- AI (console.anthropic.com > API keys) ---
ANTHROPIC_API_KEY=
# Model for grading, debriefs, call prep and story drafts. Opus 5.5 is the default; claude-sonnet-5-5 costs about half.
AI_MODEL=claude-opus-5-5
# Model for quick calls (interviewer follow-up questions).
AI_MODEL_QUICK=claude-haiku-5-5

# --- Plan limits ---
FREE_AI_PER_WEEK=15
PRO_AI_PER_DAY=150

# --- Payments (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The recurring Price for Pro (Product catalog > your product > Price ID, starts with price_)
STRIPE_PRICE_ID=
# Shown in the upgrade dialog. Keep it in sync with the Stripe price.
PRICE_LABEL=$19/month

# Optional. Lets "Delete my account" also remove the person's sign-in record from Supabase
# (Project Settings > API > service_role key). Keep this one secret: it bypasses all database protections.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
PORT=3000
# Comma-separated emails that can see founder stats and moderate any club leaderboard.
ADMIN_EMAILS=
# Shown on the privacy and support pages.
SUPPORT_EMAIL=
